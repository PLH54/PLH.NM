local fpsCapValue = 60
local fpsCapApplied = 60
local fpsLockEnabled = false
local fpsLockThread = nil
local fpsLockTarget = nil
local syncingFps = false
local fpsSlider, fpsInput

local function normalizeFps(n)
    n = tonumber(n)
    if not n then return nil end
    n = math.floor(n + 0.5)
    if n < 1 then n = 1 end
    if n > 9999 then n = 9999 end
    return n
end

local function doSetFps(n)
    n = normalizeFps(n)
    if not n then return false end
    local applied = false
    pcall(function()
        if type(setfpscap) == "function" then
            setfpscap(n)
            applied = true
        end
    end)
    if not applied then
        pcall(function()
            local env = getgenv and getgenv() or _G
            if env and type(env.setfpscap) == "function" then
                env.setfpscap(n)
                applied = true
            end
        end)
    end
    if not applied then
        pcall(function()
            local settings = UserSettings():GetService("UserGameSettings")
            if settings and settings.SetFpsCap then
                settings:SetFpsCap(n)
                applied = true
            end
        end)
    end
    if applied then
        fpsCapApplied = n
    end
    return applied
end

local function getCurrentFpsCap()
    local n = nil
    pcall(function()
        if type(getfpscap) == "function" then
            n = getfpscap()
        end
    end)
    return n
end

local function stopFpsLock()
    fpsLockEnabled = false
    fpsLockTarget = nil
    if fpsLockThread then
        pcall(function() task.cancel(fpsLockThread) end)
        fpsLockThread = nil
    end
end

local function startFpsLock(n)
    n = normalizeFps(n)
    if not n then return false end
    stopFpsLock()
    fpsCapValue = n
    local okApplied = doSetFps(n)
    fpsLockEnabled = true
    fpsLockTarget = n
    fpsLockThread = task.spawn(function()
        while fpsLockEnabled and fpsLockTarget == n do
            doSetFps(n)
            task.wait(0.3)
        end
    end)
    return okApplied
end

local function syncFpsUI(n)
    syncingFps = true
    pcall(function() if fpsSlider then fpsSlider:Set(n) end end)
    pcall(function() if fpsInput and fpsInput.Set then fpsInput:Set(tostring(n)) end end)
    syncingFps = false
end

