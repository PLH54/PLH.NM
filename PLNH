ItemTab:Button({
    Title = "扫描全游戏道具",
    Desc = "扫描物品文件夹与 Tool 并填充下拉列表",
    Callback = function()
        installHook()
        local containers = findItemContainers()
        if #containers == 0 then
            WindUI:Notify({ Title = "道具扫描", Content = "未找到物品文件夹。请先在游戏里手动购买一次任意道具，再点此按钮。", Duration = 8, Icon = "search-x" })
            return
        end

        scannedItems = {}
        local seenNames = {}
        for _, container in ipairs(containers) do
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Instance") and not seenNames[child.Name] then
                    seenNames[child.Name] = true
                    table.insert(scannedItems, { name = child.Name, container = container.Name })
                end
            end
        end

        if #scannedItems == 0 then
            WindUI:Notify({ Title = "道具扫描", Content = "找到了文件夹，但里面没有物品。", Duration = 5, Icon = "search-x" })
            return
        end

        scannedRemotes = {}
