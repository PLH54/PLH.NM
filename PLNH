local touchFlingEnabled = false
local touchFlingConn = nil
local flingBusy = false

local function feFling(targetPlayer, duration)
    if flingBusy then return end
    if not targetPlayer or targetPlayer == LocalPlayer then return end
    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local myChar = LocalPlayer.Character
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not (myChar and hum and root) then return end

    flingBusy = true
    local savedCFrame = root.CFrame
    local savedWS, savedJP = hum.WalkSpeed, hum.JumpPower

    pcall(function() hum.Sit = true end)
    hum.WalkSpeed = 0
    hum.JumpPower = 0

    local massBackup = {}
    for _, part in ipairs(myChar:GetDescendants()) do
        if part:IsA("BasePart") then
            massBackup[part] = part.Massless
            part.Massless = true
            part.CanCollide = false
        end
    end

    local BIG = 9e7
    local t0 = tick()
    while tick() - t0 < (duration or 0.35) do
        if not targetRoot.Parent or not root.Parent then break end
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.new(
                    math.random(-BIG, BIG), BIG, math.random(-BIG, BIG)
                )
                part.AssemblyAngularVelocity = Vector3.new(
                    math.random(-BIG, BIG), math.random(-BIG, BIG), math.random(-BIG, BIG)
                )
            end
        end
        pcall(function()
            root.CFrame = targetRoot.CFrame + Vector3.new(0, 0.5, 0)
        end)
        RunService.Heartbeat:Wait()
    end

    for part, was in pairs(massBackup) do
        if part.Parent then
            part.Massless = was or false
            part.CanCollide = true
        end
    end

    pcall(function()
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        hum.Sit = false
        hum.WalkSpeed = savedWS
        hum.JumpPower = savedJP
        root.CFrame = savedCFrame
    end)

    flingBusy = false
end

