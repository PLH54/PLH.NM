local function applyIce()
    clearFire()
    clearIce()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local emit = Instance.new("ParticleEmitter")
            emit.Name = "PLH_Ice"
            emit.Texture = "rbxassetid://243660364"
            emit.Rate = 25
            emit.Lifetime = NumberRange.new(0.5, 1)
            emit.Speed = NumberRange.new(1, 3)
            emit.SpreadAngle = Vector2.new(180, 180)
            emit.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.5),
                NumberSequenceKeypoint.new(1, 0)
            })
            emit.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 240, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 180, 255))
            })
            emit.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.3),
                NumberSequenceKeypoint.new(1, 1)
            })
            emit.Parent = part
        end
    end
end

