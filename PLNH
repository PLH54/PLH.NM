NPCTab:Button({
    Title = "操控NPC移动",
    Desc = "把NPC变成你的可操控角色，用方向键控制",
    Callback = function()
        local t = getSelectedNPC()
        if not t then
            WindUI:Notify({ Title = "NPC操控", Content = "请先选择目标", Duration = 2, Icon = "alert-circle" })
            return
        end
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local phum = t:FindFirstChildOfClass("Humanoid")
        local phrp = t:FindFirstChild("HumanoidRootPart")
        if not (myHum and myRoot and phum and phrp) then return end
        local cam = workspace.CurrentCamera
        npcStopFlag += 1
        local id = npcStopFlag
        local oldAnchor = myRoot.Anchored
        local oldCamSubject = cam.CameraSubject
        myRoot.Anchored = true
        cam.CameraSubject = phum
        task.spawn(function()
            while t and t.Parent and id == npcStopFlag and phrp.Parent and phum.Parent and phum.Health > 0 do
                if phum.WalkSpeed <= 0 then phum.WalkSpeed = 16 end
                phum:MoveTo(phrp.Position + myHum.MoveDirection * 3)
                phum.Jump = myHum.Jump
                RunService.Heartbeat:Wait()
            end
            pcall(function()
                myRoot.Anchored = oldAnchor
                cam.CameraSubject = oldCamSubject
            end)
        end)
    end,
})

