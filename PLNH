local function startFly()
    if flying then
        WindUI:Notify({ Title = "飞行", Content = "飞行已经在运行", Duration = 2, Icon = "info" })
        return
    end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then
        WindUI:Notify({ Title = "飞行", Content = "角色尚未加载", Duration = 3, Icon = "alert-circle" })
        return
    end

    flying = true
    savedFlyWalkSpeed = hum.WalkSpeed
    hum.WalkSpeed = 0

    local bv = Instance.new("BodyVelocity")
    bv.Name = "PLH_FlyVelocity"
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.Name = "PLH_FlyGyro"
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 10000
    bg.D = 500
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    buildFlyUI()

    flyConn = RunService.Heartbeat:Connect(function()
        if not flying then return end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        local v = h:FindFirstChild("PLH_FlyVelocity")
        local g = h:FindFirstChild("PLH_FlyGyro")
        if not v or not g then return end

        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if flyHeld.up then dir = dir + Vector3.new(0, 1, 0) end
        if flyHeld.down then dir = dir + Vector3.new(0, -1, 0) end
        if flyHeld.left then dir = dir - cam.CFrame.RightVector end
        if flyHeld.right then dir = dir + cam.CFrame.RightVector end
        if flyHeld.forward then dir = dir + cam.CFrame.LookVector end
        if flyHeld.backward then dir = dir - cam.CFrame.LookVector end

        v.Velocity = (dir.Magnitude > 0) and (dir.Unit * flySpeed) or Vector3.zero
        g.CFrame = cam.CFrame
    end)

    WindUI:Notify({ Title = "飞行", Content = "飞行已开启！使用屏幕按钮控制方向", Duration = 3, Icon = "plane" })
end

