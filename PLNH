            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Instance") and not seenNames[child.Name] then
                    seenNames[child.Name] = true
                    table.insert(scannedItems, { name = child.Name, container = container.Name })
                end
            end
        end

        if #scannedItems == 0 then
            WindUI:Notify({ Title = "道具扫描", Content = "找到了文件夹，但里面没有物品。", Duration = 5, Icon = "search-x" })
            return
        end

        scannedRemotes = {}
        for remote in pairs(capturedBuyRemotes) do
            table.insert(scannedRemotes, remote)
        end
        if #scannedRemotes == 0 then
            for _, obj in ipairs(game:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local n = tostring(obj.Name):lower()
                    if n:find("buy") or n:find("purchase") or n:find("getitem") or n:find("claim") or n:find("shop") or n:find("give") then
                        table.insert(scannedRemotes, obj)
                    end
                end
            end
        end

        local names = {}
        for _, e in ipairs(scannedItems) do
            table.insert(names, e.name)
        end

        pcall(function() itemDropdown:Refresh(names) end)

        local content
        if #scannedRemotes == 0 then
            content = string.format("扫描到 %d 个道具，但未找到购买远程。获取时仍会尝试直接放入背包。", #scannedItems)
        else
            content = string.format("扫描完成！道具 %d 个，购买远程 %d 个。", #scannedItems, #scannedRemotes)
        end

        WindUI:Notify({ Title = "道具扫描", Content = content, Duration = 6, Icon = "search-check" })
    end,
})

local function placeItemInBackpack(itemName)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then
        local char = LocalPlayer.Character
        backpack = char and char:FindFirstChild("Backpack")
    end
    if not backpack then
        pcall(function()
            backpack = Instance.new("Backpack")
            backpack.Parent = LocalPlayer
        end)
    end
    if not backpack then return false end

    local roots = {
        game:GetService("ReplicatedStorage"),
        game:GetService("ServerStorage"),
        game:GetService("StarterPack"),
        game:GetService("Workspace"),
    }

    for _, root in ipairs(roots) do
        local ok2, found = pcall(function() return root:FindFirstChild(itemName, true) end)
        if ok2 and found and found ~= backpack then
            if found:IsA("Tool") then
                local clone = found:Clone()
                clone.Parent = backpack
                return true
            elseif found:IsA("Model") then
                local handle = found:FindFirstChild("Handle") or found:FindFirstChildWhichIsA("BasePart", true)
                if handle then
                    local tool = Instance.new("Tool")
                    tool.Name = itemName
                    tool.RequiresHandle = false
                    found:Clone().Parent = tool
                    tool.Parent = backpack
                    return true
                end
            end
        end
    end
    return false
end

local function tryFireRemotes(itemName)
    local sent = 0
    if #scannedRemotes == 0 then return sent end

    local payloads = {
        { itemName },
        { itemName, 1 },
        { itemName, "Buy" },
        { itemName, 1, "Buy" },
        { "Buy", itemName },
        { itemName, true },
    }

    for _, remote in ipairs(scannedRemotes) do
        for _, args in ipairs(payloads) do
            local ok2 = pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(table.unpack(args))
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(table.unpack(args))
                end
            end)
            if ok2 then sent = sent + 1 end
            task.wait(0.03)
        end
    end
    return sent
end

