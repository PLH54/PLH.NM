local flyGui = nil
local savedFlyWalkSpeed = nil

local function destroyFlyUI()
    if flyGui then
        pcall(function() flyGui:Destroy() end)
        flyGui = nil
    end
end

local function stopFly()
    if not flying and not flyGui then return end
    flying = false

    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bv = hrp:FindFirstChild("PLH_FlyVelocity")
        if bv then bv:Destroy() end
        local bg = hrp:FindFirstChild("PLH_FlyGyro")
        if bg then bg:Destroy() end
    end

    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = savedFlyWalkSpeed or currentSpeed
    end
    savedFlyWalkSpeed = nil

    for k in pairs(flyHeld) do flyHeld[k] = false end

    destroyFlyUI()

    WindUI:Notify({ Title = "飞行", Content = "飞行已关闭", Duration = 2, Icon = "plane" })
end

