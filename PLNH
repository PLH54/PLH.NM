local function getSelectedNPC()
    if selectedNPC and selectedNPC.Parent then
        return selectedNPC
    end
    return nil
end

local function findClosestNPC()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local dist = math.huge
    local closest = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v ~= myChar then
            local phrp = v:FindFirstChild("HumanoidRootPart")
            local phum = v:FindFirstChildOfClass("Humanoid")
            if phrp and phum then
                local d = (myRoot.Position - phrp.Position).Magnitude
                if d < dist and phum.Health > 0 and phrp.ReceiveAge == 0 then
                    dist = d
                    closest = v
                end
            end
        end
    end
    return closest
end

